<resources>
<style name="KongyeDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
<item name="android:fontFamily">sans</item><item name="android:colorAccent">#28765A</item><item name="android:colorControlActivated">#28765A</item>
<item name="android:textColorPrimary">#1E2E26</item><item name="android:textColorSecondary">#8B958B</item><item name="android:windowBackground">@drawable/dialog_surface</item>
<item name="android:buttonStyle">@style/KongyeDialogButton</item><item name="android:windowMinWidthMajor">88%</item><item name="android:windowMinWidthMinor">88%</item>
<item name="android:backgroundDimAmount">0.22</item><item name="android:windowLightStatusBar">true</item></style>
<style name="KongyeDialogButton" parent="android:style/Widget.Material.Button.Borderless"><item name="android:background">@drawable/dialog_button</item><item name="android:textColor">#28765A</item><item name="android:textSize">13sp</item><item name="android:textAllCaps">false</item><item name="android:minHeight">40dp</item></style>
<style name="KongyeDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
<item name="android:fontFamily">sans</item><item name="android:colorAccent">#83CCA8</item><item name="android:colorControlActivated">#83CCA8</item>
<item name="android:textColorPrimary">#E6EEE9</item><item name="android:textColorSecondary">#97A59D</item><item name="android:windowBackground">@drawable/dialog_surface_dark</item>
<item name="android:buttonStyle">@style/KongyeDialogButtonDark</item><item name="android:windowMinWidthMajor">88%</item><item name="android:windowMinWidthMinor">88%</item><item name="android:backgroundDimAmount">0.22</item></style>
<style name="KongyeDialogButtonDark" parent="KongyeDialogButton"><item name="android:background">@drawable/dialog_button_dark</item><item name="android:textColor">#83CCA8</item></style>
</resources>